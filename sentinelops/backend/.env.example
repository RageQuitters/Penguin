# SentinelOps — Environment Variables
# Copy to .env and fill in values

# ── Huawei Cloud IAM ────────────────────────────────────────────────────────
HUAWEI_REGION=ap-southeast-3
HUAWEI_PROJECT_ID=your_project_id
HUAWEI_IAM_USERNAME=your_iam_username
HUAWEI_IAM_PASSWORD=your_iam_password
HUAWEI_IAM_DOMAIN=your_account_domain

# ── Pangu LLM (ModelArts inference endpoint or Pangu API Gateway) ───────────
# Set PANGU_API_BASE to enable real LLM calls; leave empty for mock mode
PANGU_API_BASE=https://infer-modelarts-ap-southeast-3.myhuaweicloud.com/modelarts/v1/infers/<deployment_id>
PANGU_API_KEY=your_pangu_api_key
PANGU_MODEL=pangu-chat
PANGU_AUTH_MODE=apikey   # "apikey" or "iam"

# ── ModelArts ML inference (optional; uses local joblib if empty) ────────────
MODELARTS_URGENCY_ENDPOINT=https://infer-modelarts-ap-southeast-3.myhuaweicloud.com/modelarts/v1/infers/<urgency_id>
MODELARTS_FAULT_ENDPOINT=https://infer-modelarts-ap-southeast-3.myhuaweicloud.com/modelarts/v1/infers/<fault_id>
MODELARTS_API_KEY=your_modelarts_api_key

# ── GaussDB ─────────────────────────────────────────────────────────────────
GAUSSDB_HOST=your-gaussdb-host.gaussdb.ap-southeast-3.myhuaweicloud.com
GAUSSDB_PORT=5432
GAUSSDB_NAME=sentinelops
GAUSSDB_USER=your_db_user
GAUSSDB_PASSWORD=your_db_password

# ── OBS (Object Storage) ─────────────────────────────────────────────────────
OBS_ENDPOINT=https://obs.ap-southeast-3.myhuaweicloud.com
OBS_BUCKET=sentinelops-models
OBS_ACCESS_KEY=your_access_key
OBS_SECRET_KEY=your_secret_key

# ── DMS for Kafka ────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=your-kafka-host:9093
KAFKA_TOPIC_RAW=raw-readings
KAFKA_TOPIC_PROCESSED=processed-readings
KAFKA_USERNAME=your_kafka_user
KAFKA_PASSWORD=your_kafka_password

# ── Alerting ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SMSMSG_ENDPOINT=https://msgsms.ap-southeast-3.myhuaweicloud.com
SMSMSG_APP_KEY=your_app_key
SMSMSG_APP_SECRET=your_app_secret
